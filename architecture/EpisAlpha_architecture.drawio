&gt;reviews evidence · approves live calls" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="1 -browser" value="&lt;b&gt;Browser workbench&lt;/b&gt;&lt;br&gt;Streamlit · localhost only&lt;br&gt;Research · Evidence · Knowledge ·&lt;br&gt;Experiments" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="220" height="80" as="geometry"/></mxCell><mxCell id="1 -cli" value="&lt;b&gt;CLI (Typer)&lt;/b&gt;&lt;br&gt;seed · run · status · cancel&lt;br&gt;replay · recover · export · compare" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="220" height="80" as="geometry"/></mxCell><mxCell id="1 -conn" value="&lt;b&gt;Connectors (allowlisted)&lt;/b&gt;&lt;br&gt;sec_edgar · sec_xbrl · alpha_vantage&lt;br&gt;fetch &amp;amp; label only, never infer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -snap" value="&lt;b&gt;Snapshot builder&lt;/b&gt;&lt;br&gt;point-in-time eligibility (6 clocks)&lt;br&gt;frozen + hashed manifest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -relay" value="&lt;b&gt;Model relay (trusted)&lt;/b&gt;&lt;br&gt;holds API key · enforces budgets&lt;br&gt;no response_format · no fallback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -app" value="&lt;b&gt;Application services&lt;/b&gt;&lt;br&gt;idempotent admission · 1 active job&lt;br&gt;persisted job state" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -runner" value="&lt;b&gt;Research runner&lt;/b&gt;&lt;br&gt;8 stages · state machine&lt;br&gt;maps candidate IDs → canonical" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -tools" value="&lt;b&gt;Typed read-only tools (MCP)&lt;/b&gt;&lt;br&gt;snapshot-bound · size-capped · hashed&lt;br&gt;compute_derivation runs on host" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -replay" value="&lt;b&gt;Replay &amp;amp; recovery&lt;/b&gt;&lt;br&gt;replay = zero model/network calls&lt;br&gt;recover = new attempt, history kept" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="580" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -valid" value="&lt;b&gt;Deterministic validator&lt;/b&gt;&lt;br&gt;references · exact quotes · relations&lt;br&gt;recomputes derived numbers (A8)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -sandbox" value="&lt;b&gt;Sandbox &amp;amp; watchdog&lt;/b&gt;&lt;br&gt;Docker · 300 s wall time&lt;br&gt;cancel kills children ≤ 10 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="580" width="230" height="80" as="geometry"/></mxCell><mxCell id="1 -agent" value="&lt;b&gt;Hermes AIAgent&lt;/b&gt;&lt;br&gt;pinned c1488ac / 0.21.3&lt;br&gt;&lt;br&gt;researcher → critic → synthesizer&lt;br&gt;fresh context per stage&lt;br&gt;&lt;br&gt;memory · self-learning · shell OFF&lt;br&gt;returns CANDIDATE JSON only&lt;br&gt;proposes skills as data (A13)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="300" width="240" height="220" as="geometry"/></mxCell><mxCell id="1 -mounts" value="&lt;b&gt;Container boundary&lt;/b&gt;&lt;br&gt;snapshot · harness · skills: read-only&lt;br&gt;out/&amp;lt;run_id&amp;gt;: read-write&lt;br&gt;no keys · no DB · no labels&lt;br&gt;non-root · no DNS · pinned digest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="580" width="240" height="80" as="geometry"/></mxCell><mxCell id="1 -db" value="&lt;b&gt;SQLite (WAL)&lt;/b&gt;&lt;br&gt;canonical records&lt;br&gt;versioned assessments" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="415" y="800" width="140" height="70" as="geometry"/></mxCell><mxCell id="1 -obj" value="&lt;b&gt;Object store&lt;/b&gt;&lt;br&gt;SHA-256 addressed&lt;br&gt;raw payloads" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="567" y="800" width="140" height="70" as="geometry"/></mxCell><mxCell id="1 -runs" value="&lt;b&gt;Snapshots &amp;amp; runs&lt;/b&gt;&lt;br&gt;manifests · stages&lt;br&gt;hashed artifacts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="719" y="800" width="140" height="70" as="geometry"/></mxCell><mxCell id="1 -skills" value="&lt;b&gt;Skill library (M8)&lt;/b&gt;&lt;br&gt;versioned · revocable&lt;br&gt;mounted read-only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="871" y="800" width="140" height="70" as="geometry"/></mxCell><mxCell id="1 -views" value="&lt;b&gt;Evidence &amp;amp; graph views&lt;/b&gt;&lt;br&gt;assertion → claim → span&lt;br&gt;≤ 50 nodes per thesis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="800" width="165" height="70" as="geometry"/></mxCell><mxCell id="1 -vault" value="&lt;b&gt;Obsidian vault&lt;/b&gt;&lt;br&gt;one-way Markdown export&lt;br&gt;annotations untouched" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1265" y="800" width="165" height="70" as="geometry"/></mxCell><mxCell id="1 -evalr" value="&lt;b&gt;Evaluation reports (M6)&lt;/b&gt;&lt;br&gt;baseline vs challenger&lt;br&gt;research quality, not alpha" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="800" width="165" height="70" as="geometry"/></mxCell><mxCell id="1 -phoenix" value="&lt;b&gt;Arize Phoenix (local)&lt;/b&gt;&lt;br&gt;127.0.0.1:6006 · full content" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="220" height="46" as="geometry"/></mxCell><mxCell id="1 -log" value="&lt;b&gt;Span log (JSONL)&lt;/b&gt;&lt;br&gt;metadata only · always on" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="220" height="46" as="geometry"/></mxCell><mxCell id="1 -diagpy" value="&lt;b&gt;scripts/diagnose.py&lt;/b&gt;&lt;br&gt;checks · traceability · trend" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="220" height="46" as="geometry"/></mxCell><mxCell id="1 -z-legend" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="580" height="160" as="geometry"/></mxCell><mxCell id="1 -t-legend" value="Legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="32" y="1024" width="200" height="22" as="geometry"/></mxCell><mxCell id="1 -lg-sq0" value="" style="rounded=1;arcSize=10;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1058" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx0" value="Experience (human-facing)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="74" y="1056" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -lg-sq1" value="" style="rounded=1;arcSize=10;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1096" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx1" value="Trusted host code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="74" y="1094" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -lg-sq2" value="" style="rounded=1;arcSize=10;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx2" value="Untrusted model / container" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="74" y="1132" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -lg-sq3" value="" style="rounded=1;arcSize=10;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="1058" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx3" value="External service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="354" y="1056" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -lg-sq4" value="" style="rounded=1;arcSize=10;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="1096" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx4" value="Canonical storage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="354" y="1094" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -lg-sq5" value="" style="rounded=1;arcSize=10;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1134" width="24" height="20" as="geometry"/></mxCell><mxCell id="1 -lg-tx5" value="Derived output" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="354" y="1132" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 -z-rules" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="1020" width="990" height="160" as="geometry"/></mxCell><mxCell id="1 -t-rules" value="Rules the architecture enforces" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="652" y="1024" width="400" height="22" as="geometry"/></mxCell><mxCell id="1 -rules" value="• Agents propose; deterministic systems dispose — the host validates and assigns every ID.&lt;br&gt;• Every claim cites an exact source span; every number is reported or recomputed (A8).&lt;br&gt;• Six clocks are never collapsed; snapshots are immutable; replay makes zero calls.&lt;br&gt;• Honest outcomes: ABSTAINED ≠ REJECTED ≠ PARTIAL ≠ FAILED; an outage is never an abstention.&lt;br&gt;• Exports and logs are derived, never canonical; secrets never leave the relay or reach a log." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="1052" width="960" height="120" as="geometry"/></mxCell><mxCell id="1 -e-owner-browser" value="uses" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4